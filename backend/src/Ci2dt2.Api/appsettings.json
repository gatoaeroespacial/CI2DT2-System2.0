{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Clave": "",
    "Emisor": "ci2dt2-api",
    "Audiencia": "ci2dt2-web",
    "MinutosAcceso": 15
  },
  "BaseDatos": {
    "MigrarAlIniciar": true
  },
  "AdminInicial": {
    "Email": "",
    "Password": ""
  },
  "Frontend": {
    "Url": ""
  },
  "Cors": {
    "Origenes": []
  },
  "Smtp": {
    "Host": "",
    "Puerto": 587,
    "UsarSsl": true,
    "Usuario": "",
    "Contrasena": "",
    "Remitente": "no-responder@ucaldas.edu.co"
  },
  "DataProtection": {
    "RutaLlaves": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ci2dt2-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
